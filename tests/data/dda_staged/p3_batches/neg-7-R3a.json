{
  "batch": "7-R3a",
  "note": "in-memory mutations of the golden pockets; the batch comparison must report a mismatch for exactly the named id and none for the others",
  "mutations": [
    {
      "case": "N1",
      "kind": "drop_restriction_id",
      "id": "25mm_autocannon",
      "pocket": 0,
      "mutation": "remove `belt25mm` from item_restriction",
      "expect": "mismatch reported for this id only",
      "removed": "belt25mm"
    },
    {
      "case": "N2",
      "kind": "add_bogus_id",
      "id": "25mm_autocannon",
      "pocket": 0,
      "mutation": "append `zz_not_a_mag` to item_restriction",
      "expect": "mismatch reported for this id only"
    },
    {
      "case": "N3",
      "kind": "wrong_default",
      "id": "25mm_autocannon",
      "pocket": 0,
      "mutation": "set default_magazine to `zz_not_a_mag` (was `belt25mm`)",
      "expect": "mismatch reported for this id only"
    },
    {
      "case": "N4",
      "kind": "well_volume",
      "id": "25mm_autocannon",
      "pocket": 0,
      "mutation": "magazine_well `75 ml` -> `1 ml`",
      "expect": "mismatch reported for this id only"
    },
    {
      "case": "N5",
      "kind": "drop_restriction_id",
      "id": "25mm_rotary_cannon",
      "pocket": 0,
      "mutation": "remove `belt25mm` from item_restriction",
      "expect": "mismatch reported for this id only",
      "removed": "belt25mm"
    }
  ]
}